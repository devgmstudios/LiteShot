<!--
  LiteShot installer (WiX Toolset 5). Per-user: installs to %LocalAppData%\Programs\LiteShot without
  asking for administrator rights, adds a Start menu shortcut and starts LiteShot with Windows.
  Build with ..\build.ps1, which publishes the app first and passes Version and PublishDir.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="LiteShot"
           Manufacturer="Devgm, LLC"
           Version="$(var.Version)"
           UpgradeCode="5E0B1C9A-4D7E-4C59-9B5B-2F0D6A1E7C31"
           Scope="perUser"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="LiteShot screenshot tool" Manufacturer="Devgm, LLC" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of LiteShot is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs -->
    <Icon Id="LiteShotIcon" SourceFile="..\src\LiteShot\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="LiteShotIcon" />
    <Property Id="ARPCONTACT" Value="Devgm, LLC" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LiteShot" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="LiteShot">
      <!-- Files in the user profile need a per-user registry key path. -->
      <Component Id="AppExe" Directory="INSTALLFOLDER" Guid="9C2E4F4B-7A61-4E2D-8C1B-3F5A0D6E2B47">
        <File Id="LiteShotExe" Source="$(var.PublishDir)LiteShot.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Devgm\LiteShot" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="LiteShotShortcut" Name="LiteShot" Description="Take, annotate and share screenshots"
                  Target="[#LiteShotExe]" WorkingDirectory="INSTALLFOLDER" Icon="LiteShotIcon" />
        <RegistryValue Root="HKCU" Key="Software\Devgm\LiteShot" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Same value the app's "Start with Windows" toggle reads and writes. -->
      <Component Id="StartWithWindows" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="LiteShot" Type="string"
                       Value="&quot;[#LiteShotExe]&quot; --startup" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Close a running LiteShot before files are replaced or removed (its exit switch waits until it has quit). -->
    <SetProperty Id="WixQuietExecCmdLine" Value="&quot;[INSTALLFOLDER]LiteShot.exe&quot; --exit" Before="CloseRunningLiteShot" Sequence="execute" />
    <CustomAction Id="CloseRunningLiteShot" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CloseRunningLiteShot" Before="InstallValidate" />
    </InstallExecuteSequence>

    <!-- Setup dialogs: license, progress, and a "Launch LiteShot" checkbox at the end. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LiteShot" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LiteShotExe]" />
    <CustomAction Id="LaunchLiteShot" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLiteShot"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
